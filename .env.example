# PetroCast Application Environment & Schedule Configuration Example

VITE_API_BASE_URL=https://pramudithan-oil-price-prediction.hf.space
VITE_SENTIMENT_OVERVIEW_URL=https://pramudithan-oil-price-prediction.hf.space/sentiment/overview

# Prediction Cache & Precompute Settings
VITE_PREDICT_CACHE_TTL_SECONDS=45
VITE_PREDICTION_PRECOMPUTE_ENABLED=true
VITE_PREDICTION_PRECOMPUTE_INTERVAL_SECONDS=900

# Prediction Lock Schedule (Asia/Colombo Timezone)
VITE_PREDICTION_LOCK_SCHEDULE_ENABLED=true
VITE_PREDICTION_LOCK_SCHEDULE_TIMEZONE=Asia/Colombo
VITE_PREDICTION_LOCK_SCHEDULE_HOUR=7
VITE_PREDICTION_LOCK_SCHEDULE_MINUTE=0
VITE_PREDICTION_CLOSE_LOCK_BUFFER_MINUTES=20

# Explainability Schedule (Asia/Colombo Timezone)
VITE_EXPLAINABILITY_SCHEDULE_TIMEZONE=Asia/Colombo
VITE_EXPLAINABILITY_SCHEDULE_HOUR=7
VITE_EXPLAINABILITY_SCHEDULE_MINUTE=30
VITE_EXPLAINABILITY_SCHEDULE_RETRY_HOUR=9
VITE_EXPLAINABILITY_SCHEDULE_RETRY_MINUTE=0
